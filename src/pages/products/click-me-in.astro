---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import appIcon from "../../assets/click-me-in/app-icon.png";
import screenshotTempo from "../../assets/click-me-in/screenshot-tempo.png";
import screenshotSettings from "../../assets/click-me-in/screenshot-settings.png";
import screenshotPlaying from "../../assets/click-me-in/screenshot-playing.png";
---

<MainLayout
  title="Click Me In — A Simple Click Track for Drummers | Forge70 Labs"
  description="Click Me In is a simple, flexible click track for drummers, designed for practice, rehearsal, live performance, and recording."
>

  <article>

    <section class="hero">

      <Image src={appIcon} alt="Click Me In app icon" width={120} height={120} class="app-icon" />

      <h1>Click Me In</h1>

      <p class="description">
        A simple, flexible click track for drummers. An iOS app.
      </p>

    </section>

    <section class="app-store-cta">
      <AppStoreBadge />
    </section>

    <section>

      <h2>Designed for Musicians</h2>

      <p class="description">
        Click Me In is designed for musicians and drummers who want a
        simple, flexible click track that's easy to configure and use
        for practice, rehearsal, live performance, or recording.
      </p>

    </section>

    <section>

      <h2>Version 1.1.1 Features</h2>

      <ul>
        <li>Adjustable BPM with a large, easy-to-read tempo display</li>
        <li>Tap tempo</li>
        <li>Time signature selection</li>
        <li>Multiple click sounds: Classic, Woodblock, Electronic</li>
        <li>Adjustable click volume</li>
        <li>Visual beat feedback</li>
        <li>Configurable downbeat and regular-beat colors</li>
        <li>Adjustable pulse intensity</li>
        <li>Adjustable visual intensity</li>
        <li>Audio and visual feedback controls</li>
        <li>Light, Dark, or Follow OS theme</li>
        <li>Automatic audio recovery after phone calls, Siri, and alarms</li>
        <li>Support for the largest accessibility text sizes</li>
      </ul>

    </section>

    <section>

      <h2>What's New in 1.1.1</h2>

      <ul>
        <li>Larger tap targets for the downbeat and regular-beat color swatches</li>
        <li>Tempo and time signature controls adapt to the largest accessibility text sizes</li>
        <li>The tempo "Set" button stays reachable above the keyboard in landscape</li>
      </ul>

      <p class="description">
        Version 1.1.0 also added a Settings menu with theme selection and a
        dedicated Visual Settings screen, a larger tempo display and beat
        pulse, and automatic recovery of audio after interruptions.
      </p>

    </section>

    <section>

      <h2>Built for Musicians</h2>

      <p class="description">
        Click Me In is built around the things a drummer actually needs
        from a click track:
      </p>

      <ul>
        <li>Simple to configure</li>
        <li>Easy to see and hear</li>
        <li>Useful for practice, rehearsal, live performance, and recording</li>
        <li>Focused on the essentials, not clutter</li>
      </ul>

    </section>

    <section>

      <h2>Screenshots</h2>

      <div class="screenshots">
        <Image
          src={screenshotTempo}
          alt="Click Me In main screen with BPM dial, tap tempo, time signature selection, and sound settings"
          width={300}
        />
        <Image
          src={screenshotPlaying}
          alt="Click Me In running a click track with visual beat feedback"
          width={300}
        />
        <Image
          src={screenshotSettings}
          alt="Click Me In Settings screen with Visual Settings and Theme options"
          width={300}
        />
      </div>

    </section>

    <section>

      <h2>Privacy</h2>

      <p class="description">
        Click Me In is a local, offline app. It does not collect or
        transmit personal information. Read the <a href="/privacy">Privacy Policy</a> for details.
      </p>

    </section>

    <section>

      <h2>Questions</h2>

      <p class="description">
        Have a question or feedback about Click Me In? <a href="/contact">Contact us</a>.
      </p>

    </section>

  </article>

</MainLayout>

<style>
.hero {
    text-align: center;
    padding-bottom: var(--spacing-xl);
}

.hero :global(.app-icon) {
    border-radius: 22.5%;
    margin-bottom: var(--spacing-lg);
}

.hero .description {
    max-width: 600px;
    margin: 0 auto;
    color: var(--color-text-secondary);
}

.app-store-cta {
    text-align: center;
}

.screenshots {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    justify-content: center;
}

.screenshots :global(img) {
    width: 100%;
    max-width: 260px;
    height: auto;
    border-radius: 12px;
    border: var(--border-standard);
}
</style>
