---
import MainLayout from "../../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import AppStoreBadge from "../../components/AppStoreBadge.astro";
import ProSection from "../../components/pro/ProSection.astro";
import appIcon from "../../assets/click-me-in/app-icon.png";
import screenshotPerform from "../../assets/click-me-in/screenshot-1.2.0-perform.png";
import screenshotUnlockPro from "../../assets/click-me-in/screenshot-1.2.0-unlock-pro.png";
import screenshotMain from "../../assets/click-me-in/screenshot-1.2.0-main.png";
import screenshotSet from "../../assets/click-me-in/screenshot-1.2.0-set.png";
import screenshotSongs from "../../assets/click-me-in/screenshot-1.2.0-songs.png";
---

<MainLayout
  title="Click Me In — A Simple Click Track for Musicians | Forge70 Labs"
  description="Click Me In is a simple, flexible click track for musicians, designed for practice, rehearsal, live performance, and recording."
>

  <article>

    <section class="hero">

      <Image src={appIcon} alt="Click Me In app icon" width={120} height={120} class="app-icon" />

      <h1>Click Me In</h1>

      <p class="description">
        A simple, flexible click track for musicians. An iOS app.
      </p>

    </section>

    <section class="app-store-cta">
      <AppStoreBadge />
    </section>

    <section>

      <h2>Designed for Musicians</h2>

      <p class="description">
        Click Me In is designed for musicians who want a simple, flexible
        click track that's easy to configure and use for practice,
        rehearsal, live performance, or recording.
      </p>

    </section>

    <ProSection />

    <section>

      <h2>Features</h2>

      <ul>
        <li>Adjustable BPM with a large, easy-to-read tempo display</li>
        <li>Tap tempo</li>
        <li>Time signature selection</li>
        <li>Multiple click sounds: Classic, Woodblock, Electronic</li>
        <li>Adjustable click volume</li>
        <li>Visual beat feedback</li>
        <li>Configurable downbeat and regular-beat colors</li>
        <li>Adjustable pulse intensity</li>
        <li>Adjustable visual intensity</li>
        <li>Audio and visual feedback controls</li>
        <li>Light, Dark, or Follow OS theme</li>
        <li>Automatic audio recovery after phone calls, Siri, and alarms</li>
        <li>Keeps clicking when Bluetooth headphones or hearing aids connect, and picks back up when they reconnect</li>
        <li>Visual beat keeps going if audio output is lost, with an on-screen warning</li>
        <li>VoiceOver support, high-contrast colors, and the largest accessibility text sizes</li>
      </ul>

    </section>

    <section>

      <h2>Why Click Me In</h2>

      <p class="description">
        Click Me In is built around what musicians actually need from a
        click track:
      </p>

      <ul>
        <li>Simple to configure</li>
        <li>Easy to see and hear</li>
        <li>Useful for practice, rehearsal, live performance, and recording</li>
        <li>Focused on the essentials, not clutter</li>
      </ul>

    </section>

    <section>

      <h2>Screenshots</h2>

      <div class="screenshots">
        <Image
          src={screenshotPerform}
          alt="Click Me In Pro Perform screen playing a song at 112 BPM in 4/4, showing song 1 of 3 in set 1 of 2 with the next song up and Stop, Next, Previous, and Exit buttons"
          width={300}
        />
        <Image
          src={screenshotUnlockPro}
          alt="Unlock Pro screen listing the Perform, Songs, Sets, and Gigs features of the one-time Click Me In Pro purchase"
          width={300}
        />
        <Image
          src={screenshotMain}
          alt="Click Me In main screen with BPM dial, tap tempo, time signature selection, Play button, Songs, Sets, and Gigs buttons marked Pro, and sound settings"
          width={300}
        />
        <Image
          src={screenshotSet}
          alt="A set list in Click Me In Pro showing three songs in running order with a Play button"
          width={300}
        />
        <Image
          src={screenshotSongs}
          alt="Click Me In Pro song library with a search field and a list of songs"
          width={300}
        />
      </div>

    </section>

    <section>

      <h2>Privacy</h2>

      <p class="description">
        Click Me In keeps your settings, songs, sets, and gigs on your
        device. Forge70 Labs does not collect or transmit personal
        information, and Click Me In Pro purchases are handled entirely by
        Apple. Read the <a href="/privacy">Privacy Policy</a> for details.
      </p>

    </section>

    <section>

      <h2>Questions</h2>

      <p class="description">
        Have a question or feedback about Click Me In? <a href="/contact">Contact us</a>.
      </p>

    </section>

  </article>

</MainLayout>

<style>
.hero {
    text-align: center;
    padding-bottom: var(--spacing-xl);
}

.hero :global(.app-icon) {
    border-radius: 22.5%;
    margin-bottom: var(--spacing-lg);
}

.hero .description {
    max-width: 600px;
    margin: 0 auto;
    color: var(--color-text-secondary);
}

.app-store-cta {
    text-align: center;
}

.screenshots {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-lg);
    justify-content: center;
}

.screenshots :global(img) {
    width: 100%;
    max-width: 260px;
    height: auto;
    border-radius: var(--radius-card);
    border: var(--border-standard);
}
</style>
